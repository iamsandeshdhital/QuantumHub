# Copy to .env and edit as needed. Every value below is the default, so the app
# runs with no .env file at all.

# Web server
HOST=127.0.0.1
PORT=5000
DEBUG=false

# Set this to a random value before deploying anywhere public.
SECRET_KEY=quantumhub-dev-secret

# Pagination and search limits
PAGE_SIZE=10
MAX_PAGE_SIZE=100
MAX_SEARCH_RESULTS=50

# Test mode. Leave false in normal use.
TESTING=false
